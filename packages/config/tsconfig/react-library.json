{
  "display": "React Library",
  "compilerOptions": {
    "jsx": "react",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "react": [ "./node_modules/@types/react" ],
      "@/components/*": ["components/*"],
      "@/styles/*": ["styles/*"]
    },
    "target": "es6"
  },
  "extends": "./base.json",
  "include": ["**/*.ts", "**/*.tsx"]
}