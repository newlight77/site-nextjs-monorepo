{
  "name": "notion-adapter",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "source": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "dev": "tsc -w",
    "lint": "eslint 'src/**/*.ts*'",
    "test": "REDIS_ENABLE=false jest --passWithNoTests --coverage"
  },
  "jest": {
    "preset": "jest-presets/jest/node"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.3",
    "blog-content-service": "workspace:*",
    "blog-model": "workspace:*",
    "logger": "workspace:*",
    "notion-model": "workspace:*",
    "redis-client": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^26.0.22",
    "@types/node": "^18.11.9",
    "eslint-config-custom": "workspace:*",
    "jest": "^26.6.3",
    "jest-presets": "workspace:*",
    "tsconfig": "workspace:*",
    "typescript": "^4.8.4"
  }
}
