{
  "root": true,
  "extends": [
    "eslint-config-custom"
  ],
  "rules": {
    "@next/next/no-html-link-for-pages": "off",
    "@typescript-eslint/no-explicit-any": 0,
    "@typescript-eslint/no-non-null-assertion": 0,
    "@typescript-eslint/no-unused-vars": 2,
    "react/prop-types": 0,
    "turbo/no-undeclared-env-vars": 0
  }
}
