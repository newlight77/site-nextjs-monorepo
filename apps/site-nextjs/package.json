{
  "name": "site-oneprofile",
  "version": "1.0.0",
  "private": true,
  "description": "Oneprofile Blog with Next.js and Contentful / Notion.",
  "author": "Kong To <newlight77@gmail.com>",
  "repository": "oneprofile/site-nextjs",
  "license": "MIT",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' next dev",
    "build": "next build",
    "clean": "rm -rf .next",
    "start": "NODE_ENV=production next start",
    "export": "next build && next export",
    "deps": "run-s deps:*",
    "deps:update": "[ -z $GITHUB_ACTIONS ] && yarn add notion-client notion-types notion-utils || echo 'Skipping deps:update on CI'",
    "deps:link": "[ -z $GITHUB_ACTIONS ] && yarn link notion-client notion-types notion-utils || echo 'Skipping deps:link on CI'",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "test": "run-p test:*",
    "test:jest": "jest --passWithNoTests",
    "lint": "run-p lint:*",
    "lint:eslint": "eslint '**/*.{ts,tsx}'",
    "postexport": "node utils/post-export.js",
    "populate:contentful": "contentful space migration --space-id $CONTENTFUL_SPACE_ID --management-token $CONTENTFUL_MANAGEMENT_TOKEN utils/migrate.contentful.js --yes"
  },
  "jest": {
    "preset": "jest-presets/jest/react"
  },
  "dependencies": {
    "blog-model": "workspace:*",
    "blog-content-service": "workspace:*",
    "blog-content-contentful-adapter": "workspace:*",
    "blog-content-notion-adapter": "workspace:*",
    "dotenv-webpack": "^7.1.0",
    "github-markdown-css": "^5.1.0",
    "logger": "workspace:*",
    "next": "13.0.3",
    "parse-numeric-range": "^1.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^8.0.5",
    "react-syntax-highlighter": "^15.5.0",
    "react-library": "workspace:*"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^12.3.1",
    "@types/jest": "^26.0.22",
    "@types/node": "^18.8.5",
    "@types/react": "^18.0.21",
    "@types/react-syntax-highlighter": "^15.5.6",
    "autoprefixer": "^10.4.0",
    "contentful-cli": "^1.12.35",
    "contentful-migration": "^4.9.0",
    "cross-env": "^7.0.2",
    "eslint-config-custom-next": "workspace:*",
    "jest": "^26.6.3",
    "jest-presets": "workspace:*",
    "npm-run-all": "^4.1.5",
    "tsconfig": "workspace:*",
    "typescript": "^4.8.4"
  },
  "overrides": {
    "cacheable-request": {
      "keyv": "npm:@keyvhq/core@~1.6.6"
    }
  }
}
