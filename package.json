{
  "name": "site-oneprofile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "source .env && next dev",
    "build": "next build",
    "start": "source .env && next start",
    "export": "source .env && next build && next export",
    "postexport": "node utils/post-export.js",
    "populate:contentful": "source .env && contentful space migration --space-id $CONTENTFUL_SPACE_ID --management-token $CONTENTFUL_MANAGEMENT_TOKEN utils/migrate.contentful.js --yes"
  },
  "dependencies": {
    "contentful": "^9.1.28",
    "dotenv-webpack": "^7.1.0",
    "next": "latest",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-markdown": "^8.0.3"
  },
  "devDependencies": {
    "@types/node": "17.0.4",
    "@types/react": "17.0.38",
    "autoprefixer": "^10.4.0",
    "contentful-cli": "^1.12.35",
    "contentful-migration": "^4.9.0",
    "postcss": "^8.4.5",
    "prettier": "^2.5.1",
    "prettier-plugin-tailwindcss": "^0.1.1",
    "tailwindcss": "^3.0.7",
    "typescript": "4.5.4"
  }
}
