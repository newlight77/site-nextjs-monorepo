{
  "name": "oneprofile-site-nextjs",
  "repository": "oneprofile/site-nextjs",
  "author": "Kong To <newlight77@gmail.com>",
  "private": true,
  "scripts": {
    "setup": "pnpm install",
    "build": "turbo run build --cache-dir=.turbo",
    "clean": "turbo run clean & find . -name 'node_modules' -exec rm -fr {} \\;",
    "dev": "turbo run dev --no-cache --continue",
    "format": "prettier '**/*.{js,jsx,ts,tsx,md}' --write",
    "lint": "turbo run lint --cache-dir=.turbo",
    "start": "turbo run start",
    "test": "turbo run lint --cache-dir=.turbo",

    "build:site": "turbo run build --cache-dir=.turbo --filter={apps/site-nextjs}",
    "dev:site": "turbo run dev --no-cache --continue --filter={apps/site-nextjs}",
    "preview": "turbo run preview --filter={apps/storybook}",
    "start:site": "turbo run start --filter={apps/site-nextjs}",
    "test:logger": "turbo run lint --cache-dir=.turbo --filter logger",
    "test:redis-client": "turbo run test --cache-dir=.turbo --filter redis-client",
    "coverage:report": "sonar-scanner -Dsonar.host.url=${SONAR_URL} -Dsonar.login=${SONAR_USER} -Dsonar.password=${SONAR_PASSWORD}"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^3.3.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.7.1",
    "turbo": "^1.8.8"
  },
  "packageManager": "pnpm@8.1.0"
}